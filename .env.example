# Valores de demonstração: nenhum segredo real. Copie para .env para mudar algum valor (o .env não vai para o git).
# npm run demo lê o .env; docker compose também (as URLs dos serviços ficam fixas no compose).

# Endereço de escuta dos três serviços. Padrão 127.0.0.1 (só esta máquina). Não use 0.0.0.0 fora de um container: a demo não tem login.
# O compose já define HOST=0.0.0.0 dentro dos containers e publica as portas só em 127.0.0.1.
HOST=127.0.0.1

# Provedor de WhatsApp: waha (a demo, contra o simulador local) ou meta (cenário real)
WHATSAPP_PROVIDER=waha

# core: o sistema central
CORE_PORT=3000
CORE_URL=http://localhost:3000

# erp: ERP simulado
ERP_PORT=3100
ERP_URL=http://localhost:3100
ERP_TOKEN=demo-erp-token

# waha: simulador compatível com o WAHA (uma sessão por número da Clinic: nome:número)
WAHA_PORT=3200
WAHA_URL=http://localhost:3200
WAHA_API_KEY=demo-waha-key
WAHA_WEBHOOK_HMAC_KEY=demo-waha-hmac
WAHA_SESSIONS=sp:551130000001,rj:552130000002,cps:551930000003

# Meta Cloud API (só no cenário real; o token e o id do número ficam vazios na demo)
META_APP_SECRET=demo-meta-secret
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# Chave dos hashes de telefone e e-mail
PII_HASH_KEY=demo-pii-hash-key
