{
  "name": "clinic-cursos-demo",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12" },
  "workspaces": ["web"],
  "scripts": {
    "verify": "node scripts/verify.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "replay": "node scripts/replay.ts",
    "build:web": "npm run build --workspace web",
    "demo": "npm run build:web && node src/main.ts",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspace web"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
